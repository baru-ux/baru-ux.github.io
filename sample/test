<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>コンテスト勝率シミュレーター（3ステージ×3編成）</title>
  <style>
    :root {
      --bg: #f6f7fb;
      --card: #ffffff;
      --text: #1c2026;
      --muted: #5c6573;
      --border: #dce1e8;
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --a-color: #1d4ed8;
      --b-color: #dc2626;
      --success-bg: #eff6ff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 24px;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }
    .container { max-width: 1120px; margin: 0 auto; }
    h1 { font-size: 1.4rem; margin: 0 0 6px; }
    .subtitle { color: var(--muted); font-size: 0.9rem; margin: 0 0 20px; }
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 18px;
      align-items: end;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 20px;
    }
    .field { display: flex; flex-direction: column; gap: 4px; }
    .field label { font-size: 0.8rem; color: var(--muted); font-weight: 600; }
    .field input {
      width: 120px;
      padding: 8px 10px;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.95rem;
    }
    button {
      padding: 9px 18px;
      border: none;
      border-radius: 6px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
    }
    button.primary { background: var(--accent); color: #fff; }
    button.primary:hover:not(:disabled) { background: var(--accent-hover); }
    button.secondary { background: #e5e7eb; color: #111827; }
    button:disabled { opacity: 0.55; cursor: not-allowed; }
    .sides-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }
    .side-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
    }
    .side-title {
      font-size: 1.05rem;
      font-weight: 700;
      margin: 0 0 12px;
      padding-bottom: 8px;
      border-bottom: 2px solid var(--border);
    }
    .side-title.a { border-bottom-color: var(--a-color); color: var(--a-color); }
    .side-title.b { border-bottom-color: var(--b-color); color: var(--b-color); }
    .stage-box {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 12px;
      background: #fafbfe;
    }
    .stage-box:last-child { margin-bottom: 0; }
    .stage-label { font-size: 0.85rem; font-weight: 700; margin-bottom: 8px; }
    .slot-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .slot-row:last-child { margin-bottom: 0; }
    .slot-tag { width: 46px; font-size: 0.8rem; color: var(--muted); flex-shrink: 0; }
    .slot-row input {
      flex: 1;
      padding: 7px 9px;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.85rem;
    }
    .progress-card, .result-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 20px;
    }
    .progress-text { font-size: 0.9rem; margin-bottom: 8px; }
    .progress-bar-wrap {
      width: 100%;
      height: 10px;
      background: #e5e7eb;
      border-radius: 999px;
      overflow: hidden;
    }
    .progress-bar { height: 100%; width: 0%; background: var(--accent); transition: width 0.2s ease; }
    .kpi-box {
      background: var(--success-bg);
      border: 1px solid #bfdbfe;
      border-radius: 8px;
      padding: 14px 16px;
      margin-bottom: 16px;
    }
    .kpi-main { font-size: 1.3rem; font-weight: 700; color: var(--a-color); }
    .kpi-sub { font-size: 0.88rem; color: var(--muted); margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { border: 1px solid var(--border); padding: 9px 10px; text-align: right; }
    th:first-child, td:first-child { text-align: left; }
    th { background: #f1f5f9; font-weight: 700; }
    .error-box {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 16px;
      white-space: pre-wrap;
      font-size: 0.88rem;
      display: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>コンテスト勝率シミュレーター（3ステージ×3編成）</h1>
    <p class="subtitle">
      各ステージ敵味方最高得点の20%（切り捨て）ボーナス加算・同点時A側+1点・2勝以上でマッチ勝利として勝率を算出します。
    </p>

    <div class="controls">
      <div class="field">
        <label for="trials">試行回数 (N)</label>
        <input id="trials" type="number" min="10" max="50000" step="10" value="200" />
      </div>
      <div class="field">
        <label for="seedA">シード基準 (A)</label>
        <input id="seedA" type="number" value="10000" />
      </div>
      <div class="field">
        <label for="seedB">シード基準 (B)</label>
        <input id="seedB" type="number" value="900000" />
      </div>
      <button id="runBtn" class="primary">シミュレーション実行</button>
      <button id="exportBtn" class="secondary" disabled>結果JSONを保存</button>
    </div>

    <div id="errorBox" class="error-box"></div>

    <div class="sides-grid">
      <!-- 左側 (A) -->
      <div class="side-card">
        <div class="side-title a">左側（A）— ステージ1〜3 × 各3編成URL</div>
        <div class="stage-box">
          <div class="stage-label">ステージ 1</div>
          <div class="slot-row"><span class="slot-tag">枠 1</span><input id="a-1-1" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 2</span><input id="a-1-2" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 3</span><input id="a-1-3" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
        </div>
        <div class="stage-box">
          <div class="stage-label">ステージ 2</div>
          <div class="slot-row"><span class="slot-tag">枠 1</span><input id="a-2-1" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 2</span><input id="a-2-2" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 3</span><input id="a-2-3" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
        </div>
        <div class="stage-box">
          <div class="stage-label">ステージ 3</div>
          <div class="slot-row"><span class="slot-tag">枠 1</span><input id="a-3-1" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 2</span><input id="a-3-2" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 3</span><input id="a-3-3" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
        </div>
      </div>

      <!-- 右側 (B) -->
      <div class="side-card">
        <div class="side-title b">右側（B）— ステージ1〜3 × 各3編成URL</div>
        <div class="stage-box">
          <div class="stage-label">ステージ 1</div>
          <div class="slot-row"><span class="slot-tag">枠 1</span><input id="b-1-1" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 2</span><input id="b-1-2" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 3</span><input id="b-1-3" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
        </div>
        <div class="stage-box">
          <div class="stage-label">ステージ 2</div>
          <div class="slot-row"><span class="slot-tag">枠 1</span><input id="b-2-1" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 2</span><input id="b-2-2" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 3</span><input id="b-2-3" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
        </div>
        <div class="stage-box">
          <div class="stage-label">ステージ 3</div>
          <div class="slot-row"><span class="slot-tag">枠 1</span><input id="b-3-1" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 2</span><input id="b-3-2" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
          <div class="slot-row"><span class="slot-tag">枠 3</span><input id="b-3-3" type="text" placeholder="シミュレーターURL または ?以降のクエリ" /></div>
        </div>
      </div>
    </div>

    <div class="progress-card">
      <div id="progressText" class="progress-text">待機中（18個のURLまたはクエリを入力して実行してください）</div>
      <div class="progress-bar-wrap">
        <div id="progressBar" class="progress-bar"></div>
      </div>
    </div>

    <div id="resultCard" class="result-card" style="display: none;">
      <div class="kpi-box">
        <div id="kpiMain" class="kpi-main"></div>
        <div id="kpiSub" class="kpi-sub"></div>
      </div>
      <table>
        <thead>
          <tr>
            <th>ステージ</th>
            <th>A 勝率</th>
            <th>A 平均点</th>
            <th>A SD</th>
            <th>B 平均点</th>
            <th>B SD</th>
          </tr>
        </thead>
        <tbody id="stageTableBody"></tbody>
      </table>
    </div>
  </div>

  <script type="module">
    const runBtn = document.getElementById("runBtn");
    const exportBtn = document.getElementById("exportBtn");
    const errorBox = document.getElementById("errorBox");
    const progressText = document.getElementById("progressText");
    const progressBar = document.getElementById("progressBar");
    const resultCard = document.getElementById("resultCard");
    const kpiMain = document.getElementById("kpiMain");
    const kpiSub = document.getElementById("kpiSub");
    const stageTableBody = document.getElementById("stageTableBody");

    function showError(msg) {
      errorBox.style.display = "block";
      errorBox.textContent = msg;
    }

    function clearError() {
      errorBox.style.display = "none";
      errorBox.textContent = "";
    }

    let Engine, Stages, createSimulation, loadoutFromQuery, silenceConsole, stats;
    try {
      [Engine, { Stages }, { createSimulation }, { loadoutFromQuery, silenceConsole }, stats] =
        await Promise.all([
          import("gakumas-engine"),
          import("gakumas-data"),
          import("@/simulator"),
          import("./../lib.mjs"),
          import("./stats.mjs"),
        ]);
    } catch (err) {
      showError(
        "モジュールの読み込みに失敗しました（Vite開発サーバー経由で開いているか確認してください）：\n" +
          (err?.message || String(err))
      );
      runBtn.disabled = true;
    }

    let lastExportPayload = null;
    const STRATEGY = "HeuristicStrategy";

    function toQuery(raw) {
      let text = (raw || "").trim();
      const q = text.indexOf("?");
      if (q >= 0) text = text.slice(q + 1);
      return text.split("#")[0];
    }

    function buildConfig(raw, label) {
      const { IdolConfig, IdolStageConfig, StageConfig } = Engine;
      const query = toQuery(raw);
      if (!query) throw new Error(`${label} のURL/クエリが空です。`);
      const loadout = loadoutFromQuery(query);
      const stage = Stages.getById(loadout.stageId);
      if (!stage) throw new Error(`${label}: ステージが見つかりません（stageId=${String(loadout.stageId)}）。`);
      return new IdolStageConfig(new IdolConfig(loadout), new StageConfig(stage), loadout.enterPercents);
    }

    function extractScores(result) {
      const s = result?.scores;
      if (!Array.isArray(s) || s.length === 0 || !s.every((x) => typeof x === "number")) {
        throw new Error("result().scores が数値の配列ではありませんでした。");
      }
      return Float64Array.from(s);
    }

    async function simulateExisting(config, n, seed) {
      const restore = silenceConsole();
      try {
        Engine.resetRand(seed);
        const simulation = createSimulation(config, null, STRATEGY);
        await simulation.run(n);
        return extractScores(simulation.result());
      } finally {
        restore();
      }
    }

    const yieldToUI = () => new Promise((resolve) => setTimeout(resolve, 0));
    const pct = (x) => (x * 100).toFixed(2) + "%";

    runBtn.addEventListener("click", async () => {
      clearError();
      resultCard.style.display = "none";
      exportBtn.disabled = true;

      const n = Number(document.getElementById("trials").value);
      const baseSeedA = Number(document.getElementById("seedA").value);
      const baseSeedB = Number(document.getElementById("seedB").value);

      if (!Number.isFinite(n) || n < 1) {
        showError("試行回数 (N) には1以上の数値を指定してください。");
        return;
      }

      try {
        const configsA = [[], [], []];
        const configsB = [[], [], []];

        for (let s = 0; s < 3; s++) {
          for (let c = 0; c < 3; c++) {
            configsA[s][c] = buildConfig(
              document.getElementById(`a-${s + 1}-${c + 1}`).value,
              `A ステージ${s + 1}-枠${c + 1}`
            );
            configsB[s][c] = buildConfig(
              document.getElementById(`b-${s + 1}-${c + 1}`).value,
              `B ステージ${s + 1}-枠${c + 1}`
            );
          }
        }

        runBtn.disabled = true;
        const scoresA = [[], [], []];
        const scoresB = [[], [], []];
        const totalSteps = 18;
        let completed = 0;

        for (const [sideLabel, cfgGrid, outGrid, baseSeed] of [
          ["A", configsA, scoresA, baseSeedA],
          ["B", configsB, scoresB, baseSeedB],
        ]) {
          let idx = 0;
          for (let s = 0; s < 3; s++) {
            for (let c = 0; c < 3; c++) {
              idx++;
              completed++;
              progressText.textContent = `${sideLabel} ステージ${s + 1}-枠${c + 1} 実行中... (${completed}/${totalSteps})`;
              progressBar.style.width = `${(completed / totalSteps) * 100}%`;
              await yieldToUI();

              const seed = baseSeed + idx * 1009;
              outGrid[s][c] = await simulateExisting(cfgGrid[s][c], n, seed);
            }
          }
        }

        progressText.textContent = "勝率・信頼区間を集計中...";
        await yieldToUI();

        const res = stats.contestWinRate(scoresA, scoresB, n);
        const ci = stats.contestBootstrapCI(scoresA, scoresB, n, { iters: 1000 });

        kpiMain.textContent = `Aのマッチ勝率: ${pct(res.rate)}（95%信頼区間: ${pct(ci.lower)} 〜 ${pct(ci.upper)}）`;
        kpiSub.textContent = `平均獲得ステージ数: ${res.avgStageWinsA.toFixed(2)} / 3.00 ｜ 同点+1点適用回数: ${res.tieBreakCount}回 ｜ 試行回数: ${n}`;

        stageTableBody.innerHTML = "";
        for (let s = 0; s < 3; s++) {
          const sa = stats.summarize(res.stageTotalA[s]);
          const sb = stats.summarize(res.stageTotalB[s]);
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td>ステージ ${s + 1}</td>
            <td>${pct(res.stageWinRates[s])} (${res.stageWinCountsA[s]}/${n})</td>
            <td>${Math.round(sa.mean).toLocaleString()}</td>
            <td>${Math.round(sa.sd).toLocaleString()}</td>
            <td>${Math.round(sb.mean).toLocaleString()}</td>
            <td>${Math.round(sb.sd).toLocaleString()}</td>
          `;
          stageTableBody.appendChild(tr);
        }

        lastExportPayload = {
          n,
          seedA: baseSeedA,
          seedB: baseSeedB,
          matchWinRateA: res.rate,
          ci95: { lower: ci.lower, upper: ci.upper },
          stageWinRatesA: res.stageWinRates,
          A: scoresA.map((st) => st.map((arr) => [...arr])),
          B: scoresB.map((st) => st.map((arr) => [...arr])),
        };

        progressText.textContent = "完了しました。";
        progressBar.style.width = "100%";
        resultCard.style.display = "block";
        exportBtn.disabled = false;
      } catch (err) {
        showError(err?.message || String(err));
        progressText.textContent = "エラーが発生しました。";
      } finally {
        runBtn.disabled = false;
      }
    });

    exportBtn.addEventListener("click", () => {
      if (!lastExportPayload) return;
      const blob = new Blob([JSON.stringify(lastExportPayload, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "contest_winrate_result.json";
      a.click();
      URL.revokeObjectURL(url);
    });
  </script>
</body>
</html>
